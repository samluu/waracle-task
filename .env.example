# Copy to .env: `cp .env.example .env`. Read by docker compose and `make run`.

# Database
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel
# Used by `make run` (API on the host). Inside compose the API reaches the db at host `db` instead.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# API
PORT=8080
